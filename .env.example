# Copie para .env (cp .env.example .env) e ajuste. Nunca versione o .env.

# Porta da API (o front em dev usa 5173 com proxy para esta porta)
API_PORT=3333

# Segredo das sessões (>= 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Em desenvolvimento, se vazio, um segredo temporário é gerado (sessões caem ao reiniciar).
# Em produção (NODE_ENV=production) é obrigatório.
JWT_SECRET=

# Banco: vazio = PostgreSQL embutido (PGlite) em data/app-db — nada a instalar.
# Para PostgreSQL externo (ex.: docker compose up -d):
# DATABASE_URL=postgres://baldeia:baldeia@localhost:5432/baldeia
DATABASE_URL=
PGLITE_DIR=data/app-db
# Aplica a migração 002 (PostGIS) — só com DATABASE_URL apontando para PostgreSQL com PostGIS
ENABLE_POSTGIS=false

# Dados de demonstração SINTÉTICOS (contas demo + relatos), sempre rotulados. Use false em produção.
SEED_DEMO=true

# Camada Gold carregada pela API (saída do pipeline)
GOLD_SOURCE_DIR=data/gold/sptrans_gtfs_amostra

# Produção servida por HTTPS: ativa cookie Secure e upgrade-insecure-requests no CSP
HTTPS_ONLY=false
# Origem do provedor de tiles (CSP), se usar VITE_MAP_TILE_URL diferente do OSM
# MAP_TILE_ORIGIN=https://tiles.exemplo.com

# Atrás de proxy reverso (para limites por IP corretos)
TRUST_PROXY=false

# Front-end (Vite): provedor de tiles do mapa. Em produção, use um provedor próprio/comercial.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Integrações futuras (não usadas ainda — ver docs/integracoes.md)
# SPTRANS_OLHOVIVO_TOKEN=
# GTFS_RT_ALERTS_URL=
# SMTP_URL=
